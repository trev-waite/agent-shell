{
  "name": "agent-shell",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:server": "bun --env-file=.env run --watch apps/server/src/index.ts",
    "dev:gateway": "bun --env-file=.env run --watch apps/gateway/src/index.ts",
    "dev:worker": "bun --env-file=.env run --watch apps/worker/src/index.ts",
    "dev:terminal": "bun --watch apps/terminal/src/index.tsx",
    "dev:web": "bun --cwd apps/web dev",
    "typecheck": "turbo run typecheck",
    "db:generate": "bun run --bun drizzle-kit generate --config packages/storage/drizzle.config.ts",
    "db:migrate": "bun run --bun drizzle-kit migrate --config packages/storage/drizzle.config.ts",
    "test": "RELAY_INTEGRATION_TESTS=0 bun test packages/sdk/src packages/storage/src packages/runtime/src packages/providers/src packages/coordination/src packages/dispatch/src packages/pubsub/src apps/terminal/src apps/server/src apps/web/src apps/gateway/src apps/worker/src",
    "test:integration": "RELAY_INTEGRATION_TESTS=1 bun test packages/coordination/src/redis-coordinator.integration.test.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.13.0",
    "drizzle-kit": "^0.31.10",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=24.16.0"
  }
}
