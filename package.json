{
  "name": "agent-shell",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:server": "bun --env-file=.env run --watch apps/server/src/index.ts",
    "dev:terminal": "bun --watch apps/terminal/src/index.tsx",
    "dev:web": "bun --cwd apps/web dev",
    "typecheck": "turbo run typecheck",
    "db:generate": "bun run --bun drizzle-kit generate --config packages/storage/drizzle.config.ts",
    "db:migrate": "bun run --bun drizzle-kit migrate --config packages/storage/drizzle.config.ts",
    "test": "bun test packages/storage/src packages/runtime/src packages/providers/src apps/terminal/src apps/server/src apps/web/src"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.13.0",
    "drizzle-kit": "^0.31.10",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.13",
  "engines": {
    "node": ">=24.16.0"
  }
}
