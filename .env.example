GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash
# Optional: minimal | low | medium | high | none | provider-default
# GEMINI_REASONING=low
RELAY_PORT=4310
RELAY_DB_PATH=./data/relay.db
RELAY_URL=http://localhost:4310
# Comma-separated browser origins allowed to call the API (CORS). Defaults to the web UI dev server.
# RELAY_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
